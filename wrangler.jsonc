{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pipaa",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "pipaa.store",
      "custom_domain": true
    },
    {
      "pattern": "www.pipaa.store",
      "custom_domain": true
    }
  ]
}
